# Server Configuration
PORT=8080
ENVIRONMENT=production

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match the Authorized Redirect URI registered in Google Cloud Console.
# Register: https://auth.barrsa.com/auth/google/callback
GOOGLE_REDIRECT_URL=https://auth.barrsa.com/auth/google/callback

# Session Configuration
SESSION_SECRET=change-this-to-a-random-secret-key-in-production

# JWT Secret
JWT_SECRET=change-this-jwt-secret-in-production

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Frontend URL — users are redirected here after Google OAuth completes.
FRONTEND_URL=https://barrsa.com

# CORS — comma-separated allowed origins.
CORS_ORIGINS=https://barrsa.com,https://www.barrsa.com
